{
  "name": "jobs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/app.ts",
    "dev:inngest": "npx inngest-cli dev -u http://127.0.0.1:3001/api/inngest --no-discovery",
    "build": "tsup",
    "start": "node dist/app.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@hono/node-server": "^1.14.1",
    "@inngest/middleware-sentry": "0.1.3",
    "@react-email/components": "^1.0.10",
    "@sentry/node": "^10.46.0",
    "@vivotiv/db": "workspace:*",
    "@vivotiv/shared": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "hono": "^4.12.9",
    "inngest": "^3.35.0",
    "lighthouse": "^13.0.3",
    "nodemailer": "^8.0.4",
    "playwright": "1.58.2",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.16.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "eslint": "^10.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
