    "@react-email/components": "^1.0.10",
    "@sentry/node": "^10.46.0",
    "@vivotiv/db": "workspace:*",
    "@vivotiv/shared": "workspace:*",
    "ai": "^6.0.143",
    "chrome-launcher": "^1.2.1",
    "hono": "^4.12.9",
    "inngest": "^3.54.0",
    "lighthouse": "^13.0.3",
    "linkinator": "^7.6.1",
    "playwright": "1.58.2",
    "react": "19.2.4",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.14",
    "@vivotiv/eslint-config": "workspace:*",
    "@vivotiv/typescript-config": "workspace:*",
